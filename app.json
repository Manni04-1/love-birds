{
  "expo": {
    "name": "Love Birds",
    "slug": "love-birds",
    "owner": "manni04-1",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lovebirds",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2e19a979-9a8c-4016-b9c1-4f61c6badca6",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D3325F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.manni041.lovebirds",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D3325F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Love Birds uses your photos so you can share them with your partner.",
          "cameraPermission": "Love Birds uses your camera so you can take a photo of the day for your partner.",
          "microphonePermission": "Love Birds uses your microphone so you can send voice notes to your partner."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E0218A",
          "defaultChannel": "love",
          "sounds": [
            "./assets/sounds/love.wav",
            "./assets/sounds/birdsong.mp3",
            "./assets/sounds/music_box.mp3",
            "./assets/sounds/harp.mp3",
            "./assets/sounds/kalimba.mp3",
            "./assets/sounds/marimba.mp3",
            "./assets/sounds/steel_pan.mp3",
            "./assets/sounds/piano.mp3",
            "./assets/sounds/ukulele.mp3",
            "./assets/sounds/wind_chimes.mp3",
            "./assets/sounds/crystal.mp3",
            "./assets/sounds/sparkle.mp3",
            "./assets/sounds/doorbell.mp3",
            "./assets/sounds/bubbles.mp3",
            "./assets/sounds/whistle.mp3",
            "./assets/sounds/heartbeat.mp3"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Love Birds uses Face ID to unlock the app."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Love Birds uses your microphone so you can send voice notes to your partner.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Love Birds saves the photos you choose to your phone.",
          "savePhotosPermission": "Love Birds saves the photos you choose to your phone.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/nunito-sans/700Bold/NunitoSans_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Together",
              "label": "Love Birds",
              "description": "Your days together, how your partner feels and what is next",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "300dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/together.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Countdown",
              "label": "Countdown",
              "description": "Days to go until your next plan",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "400dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/countdown.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ThinkingOfYou",
              "label": "Thinking of you",
              "description": "Tap the heart to tell your partner you are thinking of them",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/thinking-of-you.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2e19a979-9a8c-4016-b9c1-4f61c6badca6"
      }
    }
  }
}
